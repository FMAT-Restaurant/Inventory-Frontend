# =============================================================================
# Configuración de ambientes (Vite)
# Copia este archivo al archivo del ambiente correspondiente y ajusta valores.
# Estos archivos NO se versionan (solo .env.example). Ver .gitignore.
# =============================================================================

# --- DEV (desarrollo local) -> .env.development ---
VITE_APP_ENV=dev
VITE_USE_MOCK=true
VITE_API_URL=

# Token de acceso (JWT) que el frontend envía al backend como
# `Authorization: Bearer <token>`. Es un mecanismo TEMPORAL para ambientes
# sin Shell federado (dev directo al backend / QA): en el futuro el token
# lo emitirá el MS de Auth y llegará al frontend a través del API Gateway.
# El token debe incluir los claims `permissions` (p. ej.
# 'inventory:items:read') para que la UI habilite cada módulo.
# VITE_AUTH_TOKEN=

# --- QA (staging/pruebas) -> .env.qa ---
# VITE_APP_ENV=qa
# VITE_USE_MOCK=false
# VITE_API_URL=https://api-qa.example.com

# --- PROD (producción) -> .env.production ---
# VITE_APP_ENV=prod
# VITE_USE_MOCK=false
# VITE_API_URL=https://api.example.com