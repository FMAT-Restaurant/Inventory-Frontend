# =============================================================================
# Configuración de ambientes (Vite)
# Copia este archivo al archivo del ambiente correspondiente y ajusta valores.
# Estos archivos NO se versionan (solo .env.example). Ver .gitignore.
# =============================================================================

# --- DEV (desarrollo local) -> .env.development ---
VITE_APP_ENV=dev
VITE_USE_MOCK=true
VITE_API_URL=

# --- QA (staging/pruebas) -> .env.qa ---
# VITE_APP_ENV=qa
# VITE_USE_MOCK=false
# VITE_API_URL=https://api-qa.example.com

# --- PROD (producción) -> .env.production ---
# VITE_APP_ENV=prod
# VITE_USE_MOCK=false
# VITE_API_URL=https://api.example.com