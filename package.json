{
  "name": "Frontend-Inventario",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:federation": "vite build && vite preview --port 5176",
    "build": "vite build",
    "build:qa": "vite build --mode qa",
    "lint": "eslint .",
    "preview": "vite preview --port 5176",
    "preview:qa": "vite preview --mode qa --port 5176",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:mock-service": "node test/mockService.test.js",
    "test:e2e": "playwright test",
    "test:e2e:docker": "docker compose -f compose.e2e.yaml run --rm e2e",
    "test:e2e:docker:update": "docker compose -f compose.e2e.yaml run --rm e2e npx playwright test --update-snapshots"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@originjs/vite-plugin-federation": "^1.4.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "http-server": "^14.1.1",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  },
  "homepage": "https://fmat-restaurant.github.io/Inventory-Frontend"
}
